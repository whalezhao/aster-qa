# ── 必改 ─────────────────────────────────────────────

# PostgreSQL 密码（compose 内的库）
POSTGRES_PASSWORD=change-me

# JWT 签名密钥，至少 32 字节；生成：openssl rand -base64 48
SECRET_KEY=change-me-to-a-random-secret-at-least-32-bytes

# 环境变量里的密钥用它加密。留空则从 SECRET_KEY 派生；
# 如果以后要轮换 SECRET_KEY，先把它固定下来，否则已存的环境密钥会解不开。
ENVIRONMENT_SECRET_KEY=

# ── 可选 ─────────────────────────────────────────────

# 浏览器访问端口 / API 直接暴露的端口 / PostgreSQL 宿主机端口
WEB_PORT=8080
API_PORT=8000
POSTGRES_PORT=5432

# Docker 镜像：命名空间和版本。本地构建/运行也使用这套 tag；
# 发布脚本会按项目版本同步这三类镜像。
DOCKERHUB_NAMESPACE=whalezhao
ASTER_QA_VERSION=0.2.0

# 前端 origin（同源部署保持默认即可）
CORS_ORIGINS=http://localhost:8080

# 登录 token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 构建镜像时若容器访问不了 PyPI/npm（企业网络/代理），设为 host
BUILD_NETWORK=default

# 单个用例的执行超时（毫秒）
CASE_TIMEOUT_MS=600000

# worker 水平扩容：副本数 × 每副本槽位是物理上限，真正并发还受界面「全局执行并发」约束
WORKER_REPLICAS=1
WORKER_CONCURRENCY=4
# 超过这个秒数没心跳，才认为 worker 失联并回收它名下的 run
WORKER_STALE_SECONDS=90
