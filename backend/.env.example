# PostgreSQL（由仓库根的 docker-compose.yml 提供）
DATABASE_URL=postgresql+asyncpg://qa:qa@localhost:5432/qa_manage

# JWT 签名密钥 —— 生产环境必须换掉
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# midscene 执行器目录（相对 backend/ 或绝对路径）
RUNNER_DIR=runner
# 单个用例的执行超时（毫秒），对应 midscene test.testTimeout
CASE_TIMEOUT_MS=600000

# 前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 执行产物定期清理（API 进程内的后台协程）
ARTIFACT_CLEANUP_ENABLED=true
ARTIFACT_RETENTION_DAYS=30
ARTIFACT_KEEP_PER_TASK=5

# 每个 worker 进程的槽位上限；全局并发在「测试任务」页配置（所有 worker 共享）
WORKER_CONCURRENCY=4
# 超过这个秒数没心跳，才认为 worker 失联并回收它名下的 run
WORKER_STALE_SECONDS=90
